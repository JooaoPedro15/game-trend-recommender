# Variaveis de ambiente do projeto.
# Mantenha aqui apenas os NOMES das variaveis, sem valores reais.
# Coloque os valores reais em .env ou .env.local, que ficam fora do Git (ver .gitignore).

# Chave da YouTube Data API v3 (usada na coleta real, em sprints futuras).
YOUTUBE_API_KEY=

# ID do meu canal principal do YouTube (ex: UCxxxxxxxxxxxxxxxxxxxxxx).
# Usado para coletar automaticamente os meus videos, separado dos canais de referencia.
MEU_CANAL_YOUTUBE_ID=
